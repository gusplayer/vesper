{
  "expo": {
    "name": "Vesper",
    "slug": "vesper",
    "scheme": "vesper",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2F0EA",
    "ios": {
      "bundleIdentifier": "com.gusplayer.vesper",
      "supportsTablet": false,
      "infoPlist": {
        "NSSupportsLiveActivities": true
      },
      "appleTeamId": "2D3R79CT8F"
    },
    "android": {
      "package": "com.gusplayer.vesper",
      "adaptiveIcon": {
        "backgroundColor": "#F2F0EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F0EA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1C1B1A"
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": false
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "Vesper lee entrenamientos, pasos y sueño para marcar solos los hábitos verificados. Nada sale del teléfono.",
          "healthUpdatePermission": "Vesper no escribe datos de salud."
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "2D3R79CT8F",
          "appGroup": "group.com.gusplayer.vesper"
        }
      ],
      "expo-localization"
    ]
  }
}
