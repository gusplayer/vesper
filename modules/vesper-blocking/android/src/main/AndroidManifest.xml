<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!--
    Granted in system Settings, not with a dialog: the app sends the user to
    ACTION_USAGE_ACCESS_SETTINGS. Lint flags it as a signature permission, which is
    exactly how it is meant to be used by third parties.
  -->
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />
  <!-- The shield is a TYPE_APPLICATION_OVERLAY window; also granted in Settings. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!--
    Android 16: the session notification asks to be promoted to a live update (the
    chip in the status bar). A normal permission; the user can turn it off per app.
  -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <!--
    Routine windows are AlarmManager alarms. Exact ones need this toggle (a Settings
    page on Android 12+, off by default from 13); without it the alarms are inexact
    and may land up to ten minutes late. Boot re-arms what a restart forgot.
  -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!--
    Package visibility (Android 11+): the picker lists launchable apps through this
    intent, never through QUERY_ALL_PACKAGES. HOME is queried to recognise the launcher
    so it is never shielded.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
  </queries>

  <application>
    <!--
      Polls UsageStatsManager while a session runs. Android 14 requires a declared
      type; there is no closer fit than specialUse, which Google Play reviews by hand.
    -->
    <service
      android:name="com.gusplayer.vesper.blocking.BlockingService"
      android:exported="false"
      android:foregroundServiceType="specialUse"
      android:stopWithTask="false">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Focus session: detects when a user-selected app comes to the foreground and covers it with a full-screen reminder until the session ends." />
    </service>

    <!-- Fallback shield for apps that refuse overlays. Translucent: it paints itself. -->
    <activity
      android:name="com.gusplayer.vesper.blocking.ShieldActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleInstance"
      android:taskAffinity=""
      android:noHistory="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <!-- Start and end alarms of routine windows, and the safety net under endsAt. -->
    <receiver
      android:name="com.gusplayer.vesper.blocking.AlarmReceiver"
      android:exported="false" />

    <!-- Re-arms every window after a reboot, an update or a clock change. -->
    <receiver
      android:name="com.gusplayer.vesper.blocking.BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
